	column 'duration_in_min (bins)' =
			IF(
				ISBLANK('Data'[duration_in_min]),
				BLANK(),
				INT('Data'[duration_in_min] / 15) * 15
			)
		formatString: 0
		lineageTag: 56cd713b-aa7e-4962-b999-8bb58c255143
		summarizeBy: none

