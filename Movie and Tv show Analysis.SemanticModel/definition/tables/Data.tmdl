table Data
	lineageTag: 5bb1c575-a800-4ad8-9be0-47e4852f25f7

	measure 'Total Titles' = DISTINCTCOUNT(Data[Key])
		formatString: 0
		lineageTag: 3a76e3c5-ac66-4e8d-a469-2f0ed3e8e76d

	measure 'TV Shows' = CALCULATE([Total Titles], Data[type] = "TV Show")
		formatString: 0
		lineageTag: 9a89fe56-a951-460f-93bf-6dcba9d9db98

	measure Movies = CALCULATE([Total Titles], Data[type] = "Movie")
		formatString: 0
		lineageTag: fd27d1e3-7173-4ab4-8ca0-97634adf2a38

	measure '% Movies' = ```
			DIVIDE([Movies], [Total Titles])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 58a0ef46-2747-4140-8123-f9bc93fed553

	measure '% TV Shows' = ```
			DIVIDE([TV Shows], [Total Titles])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 36dc0fac-5ded-4767-9292-93acd4a38b95

	measure 'Avg Movie Duration' = ```
			CALCULATE(AVERAGE(Data[duration_in_min]), Data[type] = "Movie")
			
			```
		lineageTag: a6b9710e-de62-475c-becf-3db5d1a27f75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Seasons' = ```
			CALCULATE(AVERAGE(Data[tv_shows_season]), Data[type] = "TV Show")
			
			```
		lineageTag: 9ca616e9-f98b-47d3-9e66-fa951ac7658a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Platform Share' = DIVIDE([Total Titles], CALCULATE([Total Titles], ALL(Data[source])))
		lineageTag: 08046b72-e923-408c-b8c6-bf073475a30a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Genre Count' = DISTINCTCOUNT('Genre-Map'[Genre])
		formatString: 0
		lineageTag: 9e8bf3c1-d591-4352-815a-2e3bc46e6df8

	measure 'Country Count' = DISTINCTCOUNT('Country-Map'[Country])
		formatString: 0
		lineageTag: e7d086fc-ad87-42af-bae0-16420fcc074c

	measure 'Top Genre' = MAXX(TOPN(1, VALUES('Genre-Map'[Genre]), [Total Titles]), 'Genre-Map'[Genre])
		lineageTag: 38fe6d72-dcc0-42e2-ae03-f1dbd811968a

	measure 'Top Country' = MAXX(TOPN(1, VALUES('Country-Map'[Country]), [Total Titles]), 'Country-Map'[Country])
		lineageTag: 700f99a0-296a-4f29-a5a7-d2bb9813c61a

	measure 'Genre % of Platform' =
			
			DIVIDE(
			    [Total Titles],
			    CALCULATE([Total Titles], ALL('Genre-Map'[Genre]))
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 580ba772-911a-490c-975e-9719d8a36c7e

	measure 'Top Rating' = MAXX(TOPN(1, VALUES('Data'[rating]), [Total Titles]), 'Data'[rating])
		lineageTag: 48b2de0b-e0ca-4a89-8948-f8e5a0ecb750

